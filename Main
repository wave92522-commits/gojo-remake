-- ═══════════════════════ [DAMAGE] НАСТРОЙКИ CLIENT-SIDE УРОНА ═══════════════════════
-- Все *Fraction — доля от MaxHealth цели (0.5 = 50% HP). Радиусы — в стадах.
-- Весь урон виден ТОЛЬКО тебе (локально): сервер и другие игроки его не получают.
getgenv().GojoDamageConfig = {
	HitPlayers = true,          -- бить персонажей игроков
	HitNPCs = true,             -- бить NPC / манекенов
	IgnoreForceField = true,    -- Purple стирает — ForceField не спасает
	ShowDamageNumbers = true,   -- всплывающие цифры над целью
	EraseVisual = true,         -- стёртых растворять (локально)
	Debug = true,               -- тайминги в консоль (F9): [GojoDamage][Hollow Purple +22.21s] ...
	Whitelist = {},             -- { ["NickName"] = true } — не трогать этих

	-- 虚式「茈」 Hollow Purple: мнимая масса, стирает всё на пути. Снаряд Purple2 = сфера 35 st.
	HollowPurple = {
		HitRadius = 17.5,         -- = 35 / 2 — ровно визуальная сфера
		Lethal = true,            -- прямое попадание = стирание
		DirectFraction = 1.0,     -- (если Lethal = false) доля HP за прямое
		ShockwaveRadius = 30,     -- ударная волна по касательной
		ShockwaveFraction = 0.5,  -- −50% HP
	},
	-- Imaginary Purple: Purple с одной руки. Снаряд PurpleShoot = 15.3 st + свечение/молнии.
	ImaginaryPurple = {
		HitRadius = 14,
		Lethal = true,
		DirectFraction = 1.0,
		ShockwaveRadius = 26,
		ShockwaveFraction = 0.6,  -- −60% HP
	},
	-- Unlimited Hollow Purple ("200%"): Blue по орбите → Red → слияние → гигантский взрыв над головой.
	UnlimitedPurple = {
		BlueContactRadius = 7,        -- Blue 7.7 st летает по орбите R=32 вокруг тебя
		BlueContactFraction = 0.25,   -- −25% HP за касание
		BlueContactCooldown = 0.6,    -- кд на одну цель
		RedPulseRadius = 16,          -- импульс Red у ног в момент выстрела
		RedPulseFraction = 0.35,      -- −35% HP
		ExplosionLethalRadius = 220,  -- внутри — стирание
		ExplosionMaxRadius = 360,     -- затухание до края
		ExplosionEdgeFraction = 0.35, -- урон на краю (90% у границы стирания → 35% на краю)
		ExplosionExpandTime = 0.35,   -- фронт расширяется за вспышку частиц PurpleExplode
	},
	-- 無量空処 Unlimited Void: sure-hit — бесконечная информация → паралич, мозг "перегорает".
	InfiniteVoid = {
		Radius = 200,               -- радиус домена вокруг точки каста (≈200 м как в Сибуе)
		TickInterval = 0.5,         -- тик перегрузки
		TotalDamageFraction = 1.0,  -- суммарно за 24 с домена (48 тиков ≈ 2.08% HP каждый)
		Paralyze = true,            -- паралич пойманных
		FreezeInPlace = true,       -- локально якорить на месте
		KillOnCollapse = true,      -- добить при схлопывании домена (t ≈ 28.5s)
	},
	-- Пробуждение: атак нет — только обратная техника (RCT) на себя.
	HonoredOne = {
		SelfHeal = true,
	},
}

-- ====================== CLIENT-SIDE DAMAGE ======================
getgenv().GojoDamage = (function()
--[[
	GojoDamage — client-side слой урона для скрипт-пака Gojo (The Honored One)
	==========================================================================
	• Урон меняет Humanoid.Health ТОЛЬКО на твоём клиенте. Сервер и другие игроки
	  ничего не видят — это чисто client-side (визуальный) урон.
	• Библиотека кладётся в getgenv().GojoDamage и используется из
	  HollowPurple / InfiniteVoid / ImaginaryPurple / UnlimitedPurple.
	• Вызовы урона стоят РОВНО в тех строках, где появляется визуал:
	  снаряд создан → свип подключён в тот же Heartbeat (после движения снаряда),
	  взрыв появился → урон в тот же кадр, домен открылся → sure-hit в тот же кадр.
	  Погрешность ≤ 1 кадра (~16 мс при 60 FPS).
	• Настройки берутся из getgenv().GojoDamageConfig (задаётся в Main), иначе DEFAULTS.
]]

local Players      = game:GetService("Players")
local RunService   = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris       = game:GetService("Debris")

local LocalPlayer = Players.LocalPlayer
local genv = (typeof(getgenv) == "function") and getgenv() or _G

-- ───────────────────────────── НАСТРОЙКИ ПО УМОЛЧАНИЮ ─────────────────────────────
-- Все "Fraction" — доля от MaxHealth цели (0.5 = 50% HP), чтобы "стирание" Purple
-- работало одинаково и по игроку со 100 HP, и по боссу с 10 000 HP.
local DEFAULTS = {
	HitPlayers = true,         -- бить персонажей игроков
	HitNPCs = true,            -- бить NPC / манекенов (любой Humanoid не-игрока)
	IgnoreForceField = true,   -- Purple "стирает" — ForceField не спасает
	ShowDamageNumbers = false, -- без всплывающих "-XX урона"
	EraseVisual = true,        -- стёртых Purple'ом растворять (локально)
	Debug = true,              -- печатать тайминги в консоль (F9)
	Whitelist = {},            -- { ["NickName"] = true } — этих не трогать

	-- 虚式「茈」 Hollow Purple — стирает всё в радиусе снаряда, без частичного урона.
	HollowPurple = {
		HitRadius = 20,            -- чуть больше визуала (Purple2 35 st), чтобы не было "чуть задело — жив"
		Lethal = true,
		DirectFraction = 1.0,
		ShockwaveRadius = 0,
		ShockwaveFraction = 0,
	},
	-- Imaginary Purple (одной рукой)
	ImaginaryPurple = {
		HitRadius = 18,
		Lethal = true,
		DirectFraction = 1.0,
		ShockwaveRadius = 0,
		ShockwaveFraction = 0,
	},
	-- "200%" Unlimited Hollow Purple
	UnlimitedPurple = {
		BlueContactRadius = 10,
		BlueContactLethal = true,
		BlueContactFraction = 1.0,
		BlueContactCooldown = 1.0,
		RedPulseRadius = 25,
		RedPulseLethal = true,
		RedPulseFraction = 1.0,
		ExplosionLethalRadius = 400, -- весь фронт взрыва стирает
		ExplosionMaxRadius = 400,
		ExplosionEdgeFraction = 1.0,
		ExplosionExpandTime = 0.45,
	},
	-- 無量空処 Unlimited Void — мгновенное стирание в радиусе + паралич визуально, без телепорта
	InfiniteVoid = {
		Radius = 220,
		TickInterval = 0.5,
		TotalDamageFraction = 1.0,
		Paralyze = true,
		FreezeInPlace = true,
		InstantEraseOnOpen = true,   -- стереть всех пойманных сразу при открытии домена
		KillOnCollapse = true,       -- добить тех, кто вошёл позже
		NoTeleport = true,           -- НЕ телепортировать игрока ни в домен, ни обратно
	},
	HonoredOne = {
		SelfHeal = true,
	},
}

local function merge(dst, src)
	for k, v in pairs(src) do
		if type(v) == "table" then
			if type(dst[k]) ~= "table" then dst[k] = {} end
			merge(dst[k], v)
		elseif dst[k] == nil then
			dst[k] = v
		end
	end
	return dst
end

local Lib = {}
Lib.Version = "1.0"
Lib.Config = merge(type(genv.GojoDamageConfig) == "table" and genv.GojoDamageConfig or {}, DEFAULTS)

local COLORS = {
	Purple = Color3.fromRGB(176, 84, 255),
	Blue   = Color3.fromRGB(80, 160, 255),
	Red    = Color3.fromRGB(255, 80, 80),
	Void   = Color3.fromRGB(235, 235, 255),
	Heal   = Color3.fromRGB(120, 255, 160),
}
Lib.Colors = COLORS

-- ───────────────────────────── ЛОГ ТАЙМИНГОВ ─────────────────────────────
local abilityName, abilityT0 = "Gojo", os.clock()

function Lib.Now()
	return os.clock() - abilityT0
end

function Lib.Log(fmt, ...)
	if not Lib.Config.Debug then return end
	local ok, msg = pcall(string.format, fmt, ...)
	print(string.format("[GojoDamage][%s +%.2fs] %s", abilityName, Lib.Now(), ok and msg or tostring(fmt)))
end

-- Вызывается в начале каждой способности: все тайминги в логе считаются от этого момента
function Lib.Mark(name)
	abilityName, abilityT0 = name, os.clock()
	Lib.Log("активирована — тайминги считаем от 0.00s")
end

-- ───────────────────────────── ПОИСК ЦЕЛЕЙ ─────────────────────────────
local humanoids = {}
local function track(inst)
	if inst:IsA("Humanoid") then humanoids[inst] = true end
end
for _, d in ipairs(workspace:GetDescendants()) do track(d) end
workspace.DescendantAdded:Connect(track)

local TARGET_PADDING = 2 -- половина "толщины" персонажа, чтобы хитбокс не был заниженным

local function isAllowed(char)
	local cfg = Lib.Config
	if cfg.Whitelist and cfg.Whitelist[char.Name] then return false end
	local plr = Players:GetPlayerFromCharacter(char)
	if plr then return cfg.HitPlayers and plr ~= LocalPlayer end
	return cfg.HitNPCs
end

function Lib.GetTargets()
	local list = {}
	local myChar = LocalPlayer.Character
	for hum in pairs(humanoids) do
		if not hum:IsDescendantOf(workspace) then
			humanoids[hum] = nil
		else
			local char = hum.Parent
			if char and char:IsA("Model") and char ~= myChar and hum.Health > 0 and isAllowed(char) then
				local root = hum.RootPart or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
				if root then
					list[#list + 1] = {
						Humanoid = hum,
						Character = char,
						Root = root,
						Head = char:FindFirstChild("Head"),
					}
				end
			end
		end
	end
	return list
end

local function distanceTo(target, point)
	local d = (target.Root.Position - point).Magnitude
	local head = target.Head
	if head and head:IsA("BasePart") then
		d = math.min(d, (head.Position - point).Magnitude)
	end
	return d - TARGET_PADDING
end
Lib.DistanceTo = distanceTo

-- ───────────────────────────── ВИЗУАЛ ─────────────────────────────
local function popup(target, text, color)
	if not Lib.Config.ShowDamageNumbers then return end
	local anchor = (target.Head and target.Head:IsA("BasePart")) and target.Head or target.Root
	if not anchor then return end

	local gui = Instance.new("BillboardGui")
	gui.Name = "GojoDmg"
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.new(0, 220, 0, 56)
	gui.StudsOffset = Vector3.new(math.random(-8, 8) / 10, 2.6, 0)
	gui.Adornee = anchor
	gui.Parent = anchor

	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or COLORS.Purple
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0.15
	label.Parent = gui

	TweenService:Create(gui, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		StudsOffset = gui.StudsOffset + Vector3.new(0, 3, 0),
	}):Play()
	TweenService:Create(label, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		TextTransparency = 1,
		TextStrokeTransparency = 1,
	}):Play()
	Debris:AddItem(gui, 1.05)
end
Lib.Popup = popup

-- Постоянная метка над головой (используется доменом), вернёт объект для Destroy()
local function statusTag(target, text, color)
	local anchor = (target.Head and target.Head:IsA("BasePart")) and target.Head or target.Root
	if not anchor then return nil end
	local gui = Instance.new("BillboardGui")
	gui.Name = "GojoTag"
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.new(0, 120, 0, 40)
	gui.StudsOffset = Vector3.new(0, 4.2, 0)
	gui.Adornee = anchor
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = text
	label.TextColor3 = color or COLORS.Void
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 0.2
	label.Parent = gui
	return gui
end

-- "Стирание": локально растворяем модель цели
local function eraseVisual(char)
	if not char then return end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") or p:IsA("Decal") then
			TweenService:Create(p, TweenInfo.new(0.45, Enum.EasingStyle.Quad), { Transparency = 1 }):Play()
		elseif p:IsA("ParticleEmitter") or p:IsA("Trail") or p:IsA("Beam") then
			p.Enabled = false
		end
	end
end

-- ───────────────────────────── НАНЕСЕНИЕ УРОНА (client-side) ─────────────────────────────
-- amount = math.huge → мгновенная смерть. Возвращает (попал, летально)
function Lib.Hurt(target, amount, label, color, erase)
	local hum = target.Humanoid
	if not hum or hum.Health <= 0 then return false, false end

	local lethal = (amount == math.huge) or (amount >= hum.Health)
	if lethal then
		hum.Health = 0                       -- локальная смерть (Dead state, BreakJoints у тебя на экране)
	elseif Lib.Config.IgnoreForceField then
		hum.Health = hum.Health - amount
	else
		hum:TakeDamage(amount)               -- уважает ForceField
	end

	popup(target, lethal and (label or "☠") or ("-" .. tostring(math.floor(amount + 0.5))), color or COLORS.Purple)
	if lethal and erase and Lib.Config.EraseVisual then eraseVisual(target.Character) end
	Lib.Log("%s ← %s%s", target.Character.Name,
		lethal and "СТЁРТ" or string.format("-%.0f HP", amount),
		label and (" [" .. label .. "]") or "")
	return true, lethal
end

-- ───────────────────────────── СНАРЯД (свип каждый кадр) ─────────────────────────────
-- opts: Part, Radius, Lethal, DirectFraction, ShockRadius, ShockFraction, Duration, Name
-- Подключать СРАЗУ после Heartbeat-коннекта, который двигает снаряд → в том же кадре
-- берётся уже обновлённая позиция.
function Lib.Sweep(opts)
	local part = opts.Part
	if not part then return { Stop = function() end, Hits = {} } end

	local radius     = opts.Radius or (math.max(part.Size.X, part.Size.Y, part.Size.Z) / 2)
	local shockR     = opts.ShockRadius
	local lethal     = opts.Lethal ~= false
	local directFrac = opts.DirectFraction or 1
	local shockFrac  = opts.ShockFraction or 0.5
	local duration   = opts.Duration
	local name       = opts.Name or part.Name
	local hits       = {}
	local t0         = os.clock()

	Lib.Log("%s: свип снаряда включён (R=%.1f, волна R=%s, %s)", name, radius,
		shockR and string.format("%.1f", shockR) or "-",
		lethal and "прямое = стирание" or string.format("прямое = %.0f%% HP", directFrac * 100))

	local conn
	conn = RunService.Heartbeat:Connect(function()
		if not part.Parent or (duration and os.clock() - t0 >= duration) then
			conn:Disconnect()
			Lib.Log("%s: свип выключен", name)
			return
		end
		local pos = part.Position
		for _, t in ipairs(Lib.GetTargets()) do
			local state = hits[t.Humanoid]
			if state ~= "direct" then
				local d = distanceTo(t, pos)
				if d <= radius then
					hits[t.Humanoid] = "direct"
					Lib.Hurt(t, lethal and math.huge or t.Humanoid.MaxHealth * directFrac, "ERASED", COLORS.Purple, lethal)
				elseif shockR and not state and d <= shockR then
					hits[t.Humanoid] = "shock"
					Lib.Hurt(t, t.Humanoid.MaxHealth * shockFrac, nil, COLORS.Purple)
				end
			end
		end
	end)

	return {
		Hits = hits,
		Stop = function() if conn then conn:Disconnect() end end,
	}
end

-- ───────────────────────────── КОНТАКТ (орбита Blue) ─────────────────────────────
-- opts: Part, Radius, Fraction, Cooldown, Name, Color
function Lib.Contact(opts)
	local part = opts.Part
	if not part then return { Stop = function() end } end
	local radius   = opts.Radius or 6
	local lethal   = opts.Lethal ~= false
	local frac     = opts.Fraction or 1.0
	local cooldown = opts.Cooldown or 0.5
	local name     = opts.Name or part.Name
	local lastHit  = {}
	local label    = opts.Label or (lethal and "ERASED" or nil)

	Lib.Log("%s: контактный урон включён (R=%.1f, %s, кд %.1fs)",
		name, radius, lethal and "СТИРАНИЕ" or string.format("%.0f%% HP", frac * 100), cooldown)

	local conn
	conn = RunService.Heartbeat:Connect(function()
		if not part.Parent then conn:Disconnect() return end
		local now = os.clock()
		local pos = part.Position
		for _, t in ipairs(Lib.GetTargets()) do
			if distanceTo(t, pos) <= radius then
				local last = lastHit[t.Humanoid]
				if not last or now - last >= cooldown then
					lastHit[t.Humanoid] = now
					local dmg = lethal and math.huge or t.Humanoid.MaxHealth * frac
					Lib.Hurt(t, dmg, label, opts.Color or COLORS.Blue, lethal)
				end
			end
		end
	end)

	return {
		Stop = function()
			if conn then conn:Disconnect() conn = nil end
			Lib.Log("%s: контактный урон выключен", name)
		end,
	}
end

-- ───────────────────────────── ИМПУЛЬС (одноразовая сфера) ─────────────────────────────
-- opts: Position, Radius, Fraction/lethal, Name, Color
function Lib.Pulse(opts)
	local pos    = opts.Position
	local radius = opts.Radius or 10
	local lethal = opts.Lethal ~= false
	local frac   = opts.Fraction or 1.0
	local n      = 0
	for _, t in ipairs(Lib.GetTargets()) do
		if distanceTo(t, pos) <= radius then
			n = n + 1
			local dmg = lethal and math.huge or t.Humanoid.MaxHealth * frac
			Lib.Hurt(t, dmg, lethal and "ERASED" or nil, opts.Color or COLORS.Red, lethal)
		end
	end
	Lib.Log("%s: импульс R=%.0f, %s — задето %d",
		opts.Name or "Pulse", radius, lethal and "СТИРАНИЕ" or string.format("%.0f%% HP", frac * 100), n)
	return n
end

-- ───────────────────────────── ВЗРЫВ (расширяющийся фронт) ─────────────────────────────
-- opts: Position, MaxRadius, ExpandTime, Name
-- Всё что накрывает расширяющийся фронт — стирается (мгновенная смерть + растворение).
function Lib.Explosion(opts)
	local pos    = opts.Position
	local maxR   = opts.MaxRadius or opts.LethalRadius or 200
	local expand = opts.ExpandTime or 0
	local name   = opts.Name or "Explosion"
	local hit    = {}
	local t0     = os.clock()

	Lib.Log("%s: взрыв в (%.0f, %.0f, %.0f) — СТИРАНИЕ до R=%.0f, фронт %.2fs",
		name, pos.X, pos.Y, pos.Z, maxR, expand)

	local function pass(frontR)
		for _, t in ipairs(Lib.GetTargets()) do
			if not hit[t.Humanoid] then
				local d = distanceTo(t, pos)
				if d <= frontR then
					hit[t.Humanoid] = true
					Lib.Hurt(t, math.huge, "ERASED", COLORS.Purple, true)
				end
			end
		end
	end

	if expand <= 0 then
		pass(maxR)
		return { Hits = hit }
	end

	local conn
	conn = RunService.Heartbeat:Connect(function()
		local a = math.clamp((os.clock() - t0) / expand, 0, 1)
		pass(maxR * a)
		if a >= 1 then
			conn:Disconnect()
			Lib.Log("%s: фронт взрыва достиг R=%.0f", name, maxR)
		end
	end)
	return { Hits = hit }
end

-- ───────────────────────────── ДОМЕН (sure-hit + тики + паралич) ─────────────────────────────
local function paralyzeTarget(rec, freeze)
	local t = rec.Target
	local hum, root = t.Humanoid, t.Root
	rec.Saved = {
		WalkSpeed = hum.WalkSpeed, JumpPower = hum.JumpPower, JumpHeight = hum.JumpHeight,
		AutoRotate = hum.AutoRotate, PlatformStand = hum.PlatformStand, Anchored = root.Anchored,
	}
	hum.WalkSpeed = 0
	hum.JumpPower = 0
	hum.JumpHeight = 0
	hum.AutoRotate = false
	hum.PlatformStand = true
	if freeze then pcall(function() root.Anchored = true end) end
	local animator = hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, tr in ipairs(animator:GetPlayingAnimationTracks()) do tr:Stop(0) end
	end
end

local function releaseTarget(rec)
	local s = rec.Saved
	if not s then return end
	local t = rec.Target
	local hum, root = t.Humanoid, t.Root
	pcall(function()
		hum.WalkSpeed = s.WalkSpeed
		hum.JumpPower = s.JumpPower
		hum.JumpHeight = s.JumpHeight
		hum.AutoRotate = s.AutoRotate
		hum.PlatformStand = s.PlatformStand
		root.Anchored = s.Anchored
	end)
end

-- opts: Position, Radius, TickInterval, Duration, TotalFraction, Paralyze, FreezeInPlace, KillOnCollapse, Name
-- Первый тик — в момент открытия домена (sure-hit попадает сразу). Далее ровно каждые TickInterval.
-- Цели, вошедшие в радиус позже, тоже попадают под домен.
function Lib.Domain(opts)
	local pos              = opts.Position
	local radius           = opts.Radius or 200
	local interval         = opts.TickInterval or 0.5
	local duration         = opts.Duration or 24
	local totalFrac        = opts.TotalFraction or 1
	local paralyze         = opts.Paralyze ~= false
	local freeze           = opts.FreezeInPlace ~= false
	local killOnCollapse   = opts.KillOnCollapse ~= false
	local instantErase     = opts.InstantEraseOnOpen ~= false
	local name             = opts.Name or "Domain"

	local ticks   = instantErase and 0 or math.max(1, math.floor(duration / interval + 0.5))
	local perTick = instantErase and 0 or (totalFrac / ticks)
	local victims = {}
	local t0      = os.clock()
	local nextTick, tickCount = t0, 0

	Lib.Log("%s: домен открыт — R=%.0f, %s",
		name, radius, instantErase and "мгновенное стирание" or string.format("%d тиков по %.2fs, %.2f%% HP за тик", ticks, interval, perTick * 100))

	local function capture(eraseNow)
		for _, t in ipairs(Lib.GetTargets()) do
			if not victims[t.Humanoid] then
				local d = distanceTo(t, pos)
				if d <= radius then
					local rec = { Target = t }
					victims[t.Humanoid] = rec
					if paralyze then paralyzeTarget(rec, freeze) end
					rec.Tag = statusTag(t, "∞", COLORS.Void)
					Lib.Log("%s: %s пойман (d=%.0f)", name, t.Character.Name, d)
					if eraseNow then
						Lib.Hurt(t, math.huge, "VOID", COLORS.Void, true)
					end
				end
			end
		end
	end

	-- Мгновенное стирание при открытии домена (sure-hit)
	if instantErase then
		capture(true)
	end

	local conn
	conn = RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if instantErase then
			-- Ловим всех, кто зайдёт в радиус уже после открытия — стираем сразу при попадании
			capture(true)
			if now - t0 >= duration then conn:Disconnect() end
			return
		end
		while tickCount < ticks and now >= nextTick do
			tickCount = tickCount + 1
			nextTick = nextTick + interval
			capture()
			for hum, rec in pairs(victims) do
				if hum.Health > 0 then
					Lib.Hurt(rec.Target, hum.MaxHealth * perTick, nil, COLORS.Void)
				end
			end
		end
		if tickCount >= ticks then conn:Disconnect() end
	end)

	local handle = { Victims = victims }
	function handle.Collapse()
		if conn then conn:Disconnect() end
		local n = 0
		for hum, rec in pairs(victims) do
			n = n + 1
			if killOnCollapse and hum.Health > 0 then
				Lib.Hurt(rec.Target, math.huge, "VOID", COLORS.Void)
			end
			if rec.Tag then rec.Tag:Destroy() end
			if paralyze then releaseTarget(rec) end
		end
		Lib.Log("%s: домен схлопнулся — жертв: %d", name, n)
	end
	return handle
end

-- ───────────────────────────── ОБРАТНАЯ ТЕХНИКА (Honored One) ─────────────────────────────
function Lib.SelfHeal()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum then return end
	local before = hum.Health
	hum.Health = hum.MaxHealth
	if Lib.Config.ShowDamageNumbers then
		popup({ Head = char:FindFirstChild("Head"), Root = hum.RootPart }, "+RCT", COLORS.Heal)
	end
	Lib.Log("обратная техника: HP %.0f → %.0f (локально)", before, hum.MaxHealth)
end

genv.GojoDamage = Lib
Lib.Log("библиотека загружена v%s (целей в кэше: %d)", Lib.Version, #Lib.GetTargets())
return Lib
end)()
local Damage = getgenv().GojoDamage

-- ====================== HollowPurple ======================
local function LoadHollowPurple()
local player = game.Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Lighting = game:GetService("Lighting")

-- [DAMAGE] Библиотека встроена в единый скрипт (никаких внешних loadstring).
local Damage = getgenv().GojoDamage

local EasingStyleMap = {
	[Enum.PoseEasingStyle.Linear]   = Enum.EasingStyle.Linear,
	[Enum.PoseEasingStyle.Bounce]   = Enum.EasingStyle.Bounce,
	[Enum.PoseEasingStyle.Cubic]    = Enum.EasingStyle.Cubic,
	[Enum.PoseEasingStyle.Elastic]  = Enum.EasingStyle.Elastic,
	[Enum.PoseEasingStyle.Constant] = Enum.EasingStyle.Linear,
}

local EasingDirectionMap = {
	[Enum.PoseEasingDirection.In]    = Enum.EasingDirection.In,
	[Enum.PoseEasingDirection.Out]   = Enum.EasingDirection.Out,
	[Enum.PoseEasingDirection.InOut] = Enum.EasingDirection.InOut,
}

local function PlayKeyframeSequence(Model, KeyframeSequence, SpeedMult)
	SpeedMult = SpeedMult or 1
	local keyframes = {}
	for _, kf in ipairs(KeyframeSequence:GetKeyframes()) do
		table.insert(keyframes, {Time = kf.Time, KF = kf})
	end
	table.sort(keyframes, function(a,b) return a.Time < b.Time end)

	if #keyframes == 0 then return end

	local jointData = {}     
	local motorMap = {}
	local boneMap = {}

	local function ResolveJoint(pose)
		local name = pose.Name
		if motorMap[name] then return motorMap[name], "Motor6D" end
		if boneMap[name] then return boneMap[name], "Bone" end

		for _, v in ipairs(Model:GetDescendants()) do
			if v:IsA("Motor6D") and v.Part1 and v.Part1.Name == name then
				motorMap[name] = v
				return v, "Motor6D"
			elseif v:IsA("Bone") and v.Name == name then
				boneMap[name] = v
				return v, "Bone"
			end
		end
		return nil, nil
	end

	for _, entry in ipairs(keyframes) do
		for _, pose in ipairs(entry.KF:GetDescendants()) do
			if pose:IsA("Pose") and pose.Weight > 0 then
				local joint, jtype = ResolveJoint(pose)
				if joint then
					if not jointData[pose.Name] then jointData[pose.Name] = {} end
					table.insert(jointData[pose.Name], {
						time = entry.Time,
						cframe = pose.CFrame,
						style = pose.EasingStyle,
						dir = pose.EasingDirection,
						joint = joint,
						jtype = jtype
					})
				end
			end
		end
	end

	local totalLength = keyframes[#keyframes].Time / SpeedMult
	local isPlaying = true
	local startTime = os.clock()

	local conn = RunService.Heartbeat:Connect(function()
		if not isPlaying or not Model or not Model.Parent then
			conn:Disconnect()
			return
		end

		local elapsed = (os.clock() - startTime) * SpeedMult
		local timePos = elapsed % totalLength

		for jointName, poses in pairs(jointData) do
			if #poses < 1 then continue end
			local lastPose = poses[1]
			local nextPose = poses[1]

			for i = 1, #poses - 1 do
				if timePos >= poses[i].time and timePos < poses[i+1].time then
					lastPose = poses[i]
					nextPose = poses[i+1]
					break
				end
			end

			if timePos >= poses[#poses].time then
				lastPose = poses[#poses]
				nextPose = poses[#poses]
			end

			local alpha = (nextPose.time > lastPose.time) and 
				(timePos - lastPose.time) / (nextPose.time - lastPose.time) or 0

			local easedAlpha = TweenService:GetValue(alpha,
				EasingStyleMap[nextPose.style] or Enum.EasingStyle.Linear,
				EasingDirectionMap[nextPose.dir] or Enum.EasingDirection.InOut)

			local finalCF = lastPose.cframe:Lerp(nextPose.cframe, easedAlpha)

			if lastPose.jtype == "Motor6D" then
				lastPose.joint.Transform = finalCF
			else
				lastPose.joint.Transform = finalCF
			end
		end
	end)

	return {
		Length = totalLength,
		Stop = function() isPlaying = false; if conn then conn:Disconnect() end end,
		Play = function() startTime = os.clock() end
	}
end

local asset = game:GetObjects(getcustomasset("Gojo.rbxmx"))[1]
asset.Parent = ReplicatedStorage

local tool = Instance.new("Tool")
tool.Name = "Hollow Purple"
tool.RequiresHandle = false
